{
  "behavioral-return-value": [
    {
      "input": {
        "changed": [
          "src/a.py"
        ],
        "deleted": [],
        "high_risk": []
      },
      "output": [
        "src/a.py"
      ]
    },
    {
      "input": {
        "changed": [],
        "deleted": [
          "src/a.py"
        ],
        "high_risk": [
          "src/a.py",
          "src/b.py"
        ]
      },
      "output": [
        "src/b.py"
      ]
    }
  ],
  "boundary-ownership": [
    {
      "input": "MISSING_CHARACTERIZATION_COVERAGE:src/sample.py",
      "output": [
        5
      ]
    },
    {
      "input": "UNTESTED_AREA:src/sample.py",
      "output": [
        7
      ]
    }
  ],
  "bundle-restore-fail-closed": [
    {
      "input": "archive without manifest",
      "output": "MISSING_QUALIFICATION_MANIFEST"
    },
    {
      "input": "archive with parent traversal",
      "output": "UNSAFE_BUNDLE_MEMBER"
    }
  ],
  "cli-profile-detection": [
    {
      "input": {
        "language": "python",
        "path": "src/sample.py"
      },
      "output": true
    },
    {
      "input": {
        "language": "python",
        "path": "src/sample.ts"
      },
      "output": false
    }
  ],
  "complexity-measurement": [
    {
      "input": "straight-line",
      "output": 1
    },
    {
      "input": "branch",
      "output": 2
    }
  ],
  "contract-command-policy": [
    {
      "input": {
        "adapter": "python.c901-touched.v1",
        "exit_code": 1
      },
      "output": false
    },
    {
      "input": {
        "adapter": "python.mypy-strict.v1",
        "exit_code": 1
      },
      "output": true
    }
  ],
  "git-remote-identity": [
    {
      "input": "git@GitHub.com:acme/one.git",
      "output": "github.com/acme/one"
    },
    {
      "input": "https://example.com/acme/two.git",
      "output": "example.com/acme/two"
    }
  ],
  "quality-suppression": [
    {
      "input": [],
      "output": []
    },
    {
      "input": [
        "unstructured"
      ],
      "output": [
        "QUALITY_EXCLUSION_ADDED:unstructured"
      ]
    }
  ],
  "result-identity": [
    {
      "input": "repository",
      "output": "example/one"
    },
    {
      "input": "head_sha",
      "output": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
    }
  ]
